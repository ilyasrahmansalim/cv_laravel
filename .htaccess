<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Blokir akses ke file sensitif (.env, .git, composer, artisan)
    RewriteRule ^(\.env|\.git|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan) - [F,L]

    # 2. Blokir akses langsung ke folder inti Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]

    # 3. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 4. Arahkan semua route selain file/folder fisik ke index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>